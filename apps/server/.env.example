# ---------- core ----------
NODE_ENV=development
PORT=5000
# Local:  mongodb://127.0.0.1:27017/vidya
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vidya?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/vidya
CLIENT_URL=http://localhost:5173
# Comma separated list of extra allowed origins (optional)
CORS_ORIGINS=

# ---------- auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# lax for same-site deploys, none when client and API are on different domains (needs HTTPS)
COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=

# ---------- email (leave SMTP_HOST empty to print emails to the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vidya <no-reply@vidya.dev>"

# ---------- payments (leave keys empty to use the built-in test gateway in development) ----------
# true lets a deployed demo use the simulated gateway when Razorpay keys are empty
ALLOW_TEST_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- media (leave empty to store uploads on local disk) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
