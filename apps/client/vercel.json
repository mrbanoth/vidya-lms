{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vidya-lms.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://vidya-lms.onrender.com/uploads/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://vidya-lms.onrender.com/socket.io/:path*" },
    { "source": "/((?!assets/|theme\\.js|favicon\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
